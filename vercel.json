{
    "rewrites": [],
    "redirects": [
      {
        "source": "/:path*",
        "has": [
          {
            "type": "host",
            "value": "www.fixyourtext.com"
          }
        ],
        "destination": "https://fixyourtext.com/:path*",
        "permanent": true
      },
      {
        "source": "/:path*",
        "has": [
          {
            "type": "protocol",
            "value": "http"
          }
        ],
        "destination": "https://fixyourtext.com/:path*",
        "permanent": true
      }
    ]
  }